    "name": "吉德",
    "map_id": 3406,
    "cell": [
      27,
      14
    ],
    "graphic": 16017,
    "facing": 6,
    "role": "quest",
    "text": "啊～～欢…欢迎来到奇喀喀村…。,你有没有看到我女儿…？",
    "branches": [
      {
        "event": 21,
        "type": "ACCEPT",
        "condition": "ENDEV=20&NOWEV=21&ITEM=2488",
        "texts": {
          "AcceptMsg": "这…这…这是…。这是我女儿寄给我的信\n对吧！\n那就是说…那个孩子现在还没事活的好好的\n对吧！",
          "ThanksMsg": "真是太谢谢你了。\n如果那个孩子很平安的话，我想卡娜也会\n替我感到高兴的吧！\n这样我就安心了。真是太谢谢你了。虽然我不能帮\n你什么忙，但至少请收下卡娜生前制作的\n这支木笛吧！真是太\n谢谢你了。",
          "ItemFullMsg": "对不起，你的道具太多了\n我不能将它交给你。"
        },
        "actions": {
          "DelItem": "2488",
          "GetItem": "2489",
          "EndSetFlg": "21"
        },
        "source_branch_index": 0,
        "source_line": 5,
        "enabled": true,
        "events": [
          20,
          21,
          22
        ],
        "source": "jaruga/event/event20_2"
      },
      {
        "event": 20,
        "type": "REQUEST",
        "condition": "ITEM=2486",
        "texts": {
          "RequestMsg": "我女儿被带走已经有１６年了…。\n被住在阿鲁姆山的强恩一族的那些\n家伙给带走了…不晓得现在过得如何…\n真担心…\n如果可以的话希望你能帮我把女儿救出来…\n你愿意帮我吗？",
          "ThanksMsg": "是吗？那就拜托你了。如果我女儿还活着\n的话，应该就住在阿鲁姆的山贼地\n下城里。可以的话请把她母亲的遗物的发饰\n交给那个孩子。发饰在我儿子\n那里。请去拿吧！",
          "StopMsg": "果然是不可能的吧…",
          "EndStopMsg": "是这样吗…\n那我要去找能帮我的人了…\n对不起…",
          "NoStopMsg": "不好意思！那就拜托你了！"
        },
        "actions": {
          "DelItem": "2486"
        },
        "source_branch_index": 1,
        "source_line": 17,
        "enabled": true,
        "events": [
          20,
          21,
          22
        ],
        "source": "jaruga/event/event20_2"
      },
      {
        "event": -1,
        "type": "MESSAGE",
        "condition": "ENDEV=20&ENDEV=21&ENDEV!=160",
        "texts": {
          "NomalMsg": "你那善良的心，就像神一样。我过世的妻子卡娜一定也会感到高兴的。"
        },
        "actions": {},
        "source_branch_index": 2,
