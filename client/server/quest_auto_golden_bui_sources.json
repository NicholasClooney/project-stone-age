  "npcs": [
    {
      "id": "quiz/equiz_01@810:29:16",
      "source_script": "quiz/equiz_01",
      "source_create": "gmsv/data/npc/quiz/quiz.create",
      "source_create_index": 1,
      "map_id": 810,
      "cell": [
        29,
        16
      ],
      "name": "魁司",
      "graphic": 100000,
      "facing": 4,
      "role": "quest",
      "events": [
        44
      ],
      "text": "你也以猜谜大师为目标吧！",
      "branches": [
        {
          "event": 44,
          "type": "REQUEST",
          "condition": "LV>0",
          "texts": {
            "RequestMsg": "\n\n厉害！没想到能够来到12楼呀！\n给来到这里的你猜谜大师的\n入门证吧！可以收下吗？",
            "ThanksMsg": "\n\n把这个入门证交给隔壁的伊那多\n询问成为猜谜大师的课题吧！\n你也以猜谜大师为目标！",
            "StopMsg": "\n\n\n不想成为猜谜大师？",
            "EndStopMsg": "\n\n\n那么，等你想来的时候再来吧！",
            "NoStopMsg": "\n\n\n这样的话，快点把入门证交给伊那多喔！",
            "ItemFullMsg": "\n\n\n道具已经满了无法收下的样子喔。"
          },
          "actions": {
            "GetItem": "2753"
          },
          "source_branch_index": 3,
          "source_line": 29,
          "enabled": true,
          "events": [
            44
          ],
          "source": "quiz/equiz_01"
        }
      ]
    },
    {
      "id": "quiz/equiz_02@810:28:16",
      "source_script": "quiz/equiz_02",
      "source_create": "gmsv/data/npc/quiz/quiz.create",
      "source_create_index": 2,
      "map_id": 810,
      "cell": [
        28,
        16
      ],
      "name": "伊那多",
      "graphic": 100015,
      "facing": 4,
      "role": "quest",
      "events": [
        44
      ],
      "text": "你也以猜谜大师为目标吧！",
      "branches": [
        {
          "event": 44,
          "type": "ACCEPT",
          "condition": "NOWEV=44&ITEM=2753",
          "texts": {
            "AcceptMsg": "\n\n哎呀！那个是猜谜大师的入门证吧！\n你也迈向猜谜大师之路了吗？",
            "ThanksMsg": "\n很好，很有干劲喔！\n那么的话我就出成为猜谜大师的课题啰\n等到现在交给你的稀有宠物\n等级成为LV77之后是否可以带来给我呢？\n如果无法达成这个条件的话我就没有办法带你到成为\n猜谜大师的认定场\n认定场喔。那么、加油啰！",
            "PetFullMsg": "\n\n因为宠物太多而无法交给你喔。\n能否把宠物的数量减少之后再来呢？"
          },
          "actions": {
            "GetPet": "14",
            "DelItem": "2753",
            "EndSetFlg": "44"
          },
          "source_branch_index": 4,
          "source_line": 38,
          "enabled": true,
          "events": [
            44
          ],
          "source": "quiz/equiz_02"
        }
      ]
    },
