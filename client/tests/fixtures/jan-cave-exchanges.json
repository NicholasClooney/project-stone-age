            22
          ],
          "source": "jaruga/event/event20_2"
        }
      ]
    },
    {
      "id": "jaruga/event/event20_3@3406:28:17",
      "source_script": "jaruga/event/event20_3",
      "source_create": "gmsv/data/npc/jaruga/event/event20.create",
      "source_create_index": 2,
      "events": [
        20,
        21,
        22
      ],
      "name": "吉德的儿子",
      "map_id": 3406,
      "cell": [
        28,
        17
      ],
      "graphic": 16046,
      "facing": 6,
      "role": "quest",
      "text": "奇喀喀村位于这个世界的最南边。,我爸爸因为妹妹被绑架而一直委靡不振。",
      "branches": [
        {
          "event": 20,
          "type": "ACCEPT",
          "condition": "NOWEV=20&ITEM!=2487",
          "texts": {
            "AcceptMsg": "这个大概是我妹妹唯一记得的东西吧。\n这是我妈妈的发饰。妈妈把她背在被上\n的时候，她常常抓着这个玩。\n如果你找到我妹妹的话请你一定要\n把她救回来喔！",
            "ThanksMsg": "谢谢！这是我妈妈的遗物。\n我妈妈因为妹妹被抓走而深受打击，从此一病不起。\n就在两年后去世了。\n如果你找到我妹妹的话，请把这个交给她。\n…拜托你了。\n请小心，千万别把它弄丢了喔！",
            "ItemFullMsg": "你的道具太多了，我无法把它交给你。"
          },
          "actions": {
            "GetItem": "2487"
          },
          "source_branch_index": 0,
          "source_line": 6,
          "enabled": true,
          "events": [
            20,
            21,
            22
          ],
          "source": "jaruga/event/event20_3"
        },
        {
          "event": 20,
          "type": "MESSAGE",
          "condition": "NOWEV=20&ITEM=2487",
          "texts": {
            "NomalMsg": "那就拜托你了。强恩一族是这附近恶名昭彰的山贼。请千万要小心。"
          },
          "actions": {},
          "source_branch_index": 1,
          "source_line": 16,
          "enabled": true,
          "events": [
            20,
            21,
            22
          ],
          "source": "jaruga/event/event20_3"
        },
        {
          "event": -1,
          "type": "MESSAGE",
          "condition": "ENDEV=20&ENDEV=21",
          "texts": {
            "NomalMsg": "真是太谢谢你了。我妈妈也一定会很高兴的。如果可以的话真希望她们还能相见…"
          },
          "actions": {},
          "source_branch_index": 2,
          "source_line": 23,
          "enabled": true,
          "events": [
            20,
