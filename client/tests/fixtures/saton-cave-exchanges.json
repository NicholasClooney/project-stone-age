      "name": "关怀老人的年轻人",
      "map_id": 1100,
      "cell": [
        86,
        99
      ],
      "graphic": 16048,
      "facing": 4,
      "role": "quest",
      "text": "在离这不远的前方，有住着老人啊…。,我是一见到老人就不能不管他们。",
      "branches": [
        {
          "event": -1,
          "type": "CLEAN",
          "condition": "ENDEV=13",
          "texts": {
            "CleanFlgMsg": "事实上，住在前面不远地方的老人，\n听说也因盗贼而受害。\n真是令人担心啊…。",
            "CleanMainMsg": "哇啊啊啊…。\n咦？说来我干嘛这么担心啊？"
          },
          "actions": {
            "CleanFlg": "13"
          },
          "source_branch_index": 0,
          "source_line": 9,
          "source_actions": {
            "CleanFlg": "13"
          },
          "source_texts": {
