{
  "purpose": "Exchange-only isolation; no guards or task activation",
  "npcs": [
    {
      "id": "sainasu/event/event13_1@1112:16:15",
      "source_script": "sainasu/event/event13_1",
      "source_create": "gmsv/data/npc/sainasu/event/event13n.create",
      "source_create_index": 0,
      "events": [
        13,
        14
      ],
      "name": "老人萨顿",
      "map_id": 1112,
      "cell": [
        16,
        15
      ],
      "graphic": 16000,
      "facing": 6,
      "role": "quest",
      "text": "有没有能帮我把遭窃的家宝取回来的强者啊…。",
      "branches": [
        {
          "event": 13,
          "type": "ACCEPT",
          "condition": "NOWEV=13&ITEM=2428&ITEM=2429&ITEM=2430",
          "texts": {
            "AcceptMsg": "喂喂喂喂喂喂！\n那不正是我们遭窃的三件传家之宝\n被拿回来了吗？",
            "ThanksMsg": "该怎么跟您说谢谢呢…\n这是我诚心诚意地\n请您一定要收下。",
            "ItemFullMsg": "喂喂！这是怎么一回事呢…\n您的道具袋已经满了啊！\n可是不能不向您道谢啊…\n请您减轻一些重量，再来一趟吧。"
          },
          "actions": {
            "GetItem": "2450",
            "DelItem": "2428,2429,2430,2431",
            "EndSetFlg": "13,14"
          },
          "source_branch_index": 0,
          "source_line": 9,
          "source_actions": {
            "GetItem": "2450",
            "DelItem": "2428,2429,2430,2431",
            "EndSetFlg": "13"
          },
          "source_texts": {
            "AcceptMsg": "喂喂喂喂喂喂！\n那不正是我们遭窃的三件传家之宝\n被拿回来了吗？",
            "ThanksMsg": "该怎么跟您说谢谢呢…\n这是我诚心诚意地\n请您一定要收下。",
            "ItemFullMsg": "喂喂！这是怎么一回事呢…\n您的道具袋已经满了啊！\n可是不能不向您道谢啊…\n请您减轻一些重量，再来一趟吧。"
          },
          "project_supplement": {
            "script": "sainasu/event/event13_1",
            "branch": 0,
            "end_flags_add": [
              14
            ],
            "annotation": "补充·依据编号登记；用户授权萨顿完成时同时补记14",
            "approval": "docs/reverse-engineering/rebirth-quest-bonus-audit.md"
          },
          "enabled": true,
          "events": [
            13,
            14
          ],
          "source": "sainasu/event/event13_1"
        },
        {
          "event": 13,
          "type": "MESSAGE",
          "condition": "NOWEV=13&ITEM!=2431",
          "texts": {
            "NomalWindowMsg": "啊…足以为证的脚印消失了啊…\n我会再做一次，\n这一回请不要消失。",
            "ItemFullMsg": "道具栏已经满了喔！\n不知 到能不能麻烦你挪出空间来呢？"
          },
          "actions": {
            "GetItem": "2431"
          },
          "source_branch_index": 1,
          "source_line": 20,
          "enabled": true,
          "events": [
            13,
            14
          ],
          "source": "sainasu/event/event13_1"
        },
        {
          "event": 13,
          "type": "REQUEST",
          "condition": "LV>15",
          "texts": {
            "RequestMsg": "呜呜呜…\n传家宝被盗贼偷走了…。\n实在很想把它拿回来啊…。\n不过以我这样的身子，\n虽然我知道这是无理的请求，\n但还是请您\n一定要帮我取回家传的三种神器。",
            "ThanksMsg": "喂喂喂喂喂喂！\n你愿不愿意帮我啊？\n嗯嗯嗯、不是在这个世界上不见的啊！？\n这是留在我家里盗贼的足迹。\n只要跟着这个走的话，\n我想他们一定逃不掉。\n请把这个带去吧！\n盗贼们都在柯尔克山的洞窟里呢！",
            "StopMsg": "怎么啦？你没有信心抓到盗贼吗？",
            "EndStopMsg": "…原来如此。真抱歉，太勉强你了。\n那请你把我这可怜老人家传家宝遭窃的事忘了吧…。",
            "NoStopMsg": "这样啊！那我等你的好消息喔！\n但也不要太勉强喔！",
            "ItemFullMsg": "你的道具袋\n好像已经装不下\n这个可以足以成为证据，\n让盗贼百口莫辩的东西了…。\n请把道具袋清出空位，再来一次吧！"
          },
          "actions": {
            "GetItem": "2431*1"
          },
          "source_branch_index": 2,
          "source_line": 28,
          "enabled": true,
          "events": [
            13,
            14
          ],
          "source": "sainasu/event/event13_1"
        },
        {
          "event": -1,
          "type": "MESSAGE",
          "condition": "ENDEV=13",
          "texts": {
            "NomalWindowMsg": "那阵子真多亏您的关照啊。\n我已经把那三种神器\n小心翼翼地安置起来了。"
          },
          "actions": {},
          "source_branch_index": 3,
          "source_line": 41,
          "enabled": true,
          "events": [
            13,
            14
          ],
          "source": "sainasu/event/event13_1"
        }
      ]
    },
    {
      "id": "sainasu/event/event13_2@1100:86:99",
      "source_script": "sainasu/event/event13_2",
