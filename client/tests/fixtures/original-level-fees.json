  "npcs": [
    {
      "id": "quiz/uketuke@2020:18:13",
      "source_script": "quiz/uketuke",
      "source_create": "gmsv/data/npc/quiz/quiz.create",
      "source_create_index": 7,
      "events": [
        44
      ],
      "name": "入场卷贩售人",
      "map_id": 2020,
      "cell": [
        18,
        13
      ],
      "graphic": 16065,
      "facing": 6,
      "role": "quest",
      "text": "你也以成为猜谜大师而在努力着呀！",
      "branches": [
        {
          "event": -1,
          "type": "MESSAGE",
          "condition": "LV>69",
          "texts": {
            "NomalWindowMsg": "\n欢迎来到玛丽娜丝的道场。\n在这里贩卖着往前面的‘猜谜三兄弟的家’的入场券。\n这个道场接受LV70以下的人进来。\nLV70以上的人请往\n卡鲁它那的道场去。"
          },
          "actions": {},
          "source_branch_index": 0,
          "source_line": 8,
          "enabled": true,
          "events": [
            44
          ],
          "source": "quiz/uketuke"
        },
        {
          "event": -1,
          "type": "ACCEPT",
          "condition": "LV>49",
          "texts": {
            "AcceptMsg": "欢迎来到玛丽娜丝的道场。\n在这里贩卖着往前面的‘猜谜三兄弟的家’的入场券。\n因为你是LV50以上拿着“入场券B”进去吧。\n收下参加费%8dstone\n。这样子可以吗？",
            "ThanksMsg": "\n\n非常的谢谢你。\n确实收到了。\n那么往前走请引导B的人\n帮你介绍吧。",
            "StoneLessMsg": "\n\n非常的不好意思\n钱不够喔。",
            "ItemFullMsg": "\n\n道具已经满了。\n可以把道具减少之后\n再入场来吗？"
          },
          "actions": {
            "DelStone": "LV*40",
            "GetItem": "2756"
          },
          "source_branch_index": 1,
          "source_line": 14,
          "enabled": true,
          "events": [
            44
          ],
          "source": "quiz/uketuke"
        },
        {
          "event": -1,
          "type": "ACCEPT",
          "condition": "LV>29",
          "texts": {
            "AcceptMsg": "欢迎来到玛丽娜丝的道场。\n?在这里贩卖着往前面的‘猜谜三兄弟的家’的入场券。\n因为你是LV30以上拿着“入场券A”进去吧。\n收下参加费%8dstone\n。这样子可以吗？",
            "ThanksMsg": "\n\n非常的谢谢你。\n确实收到了。\n那么往前走请引导A的人\n帮你介绍吧。",
            "StoneLessMsg": "\n\n非常的不好意思\n钱不够喔。",
            "ItemFullMsg": "\n\n道具已经满了。\n可以把道具减少之后\n再入场来吗？"
          },
          "actions": {
            "DelStone": "LV*20",
            "GetItem": "2755"
          },
          "source_branch_index": 2,
          "source_line": 25,
          "enabled": true,
          "events": [
            44
          ],
          "source": "quiz/uketuke"
        },
        {
