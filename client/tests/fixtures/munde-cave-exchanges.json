{
  "purpose": "Exchange-only isolation; adult completion is prerequisite fixture, guard route not covered",
  "npcs": [
    {
      "id": "sainasu/event/event09@1200:97:75",
      "source_script": "sainasu/event/event09",
      "source_create": "gmsv/data/npc/sainasu/event/event09-12.create",
      "source_create_index": 0,
      "events": [
        9,
        10,
        11,
        12
      ],
      "name": "村姑",
      "map_id": 1200,
      "cell": [
        97,
        75
      ],
      "graphic": 16205,
      "facing": 6,
      "role": "quest",
      "text": "你好啊！今天天气真是不错呢！,从柯尔克山一路看过来的风景，总是很漂亮呢！,我的朋友遭到盗贼袭击，不知道有没有人伸出援手啊…。",
      "branches": [
        {
          "event": 9,
          "type": "ACCEPT",
          "condition": "ENDEV=12&ENDEV=10&ENDEV=11",
          "texts": {
            "AcceptMsg": "听说您帮了那两人的忙啊！\n真的是谢谢您啊！",
            "ThanksMsg": "您是我们的骄傲。\n您为我们在卡坦、霍特尔、柯尔克的人民，\n带来了希望之光。\n从现在起，我们一定会好好加油，\n不会败给盗贼的。\n请您，务必要把这个收下。",
            "ItemFullMsg": "哎呀！东西已经装满了呢！"
          },
          "actions": {
            "GetItem": "1357",
            "EndSetFlg": "9"
          },
          "source_branch_index": 0,
          "source_line": 3,
          "enabled": true,
          "events": [
            9,
            10,
            11,
            12
          ],
          "source": "sainasu/event/event09"
        },
        {
          "event": 9,
          "type": "REQUEST",
          "condition": "LV>29&ENDEV=4",
          "texts": {
            "RequestMsg": "如此说来，我那两个朋友在卡坦的沙漠，\n遇到了盗贼啊！总想，\n\n有没有那个人可以帮他们的忙呢？",
            "ThanksMsg": "这样啊…那你能不能帮忙呢？真是谢谢你了呢。详情请问我那住在卡坦和霍特尔的朋友吧。",
            "StopMsg": "你无法帮我的忙啊？",
            "EndStopMsg": "这样啊…\n那我再找能帮我的人好了。\n真是不好意思。",
            "NoStopMsg": "啊！那真是太谢谢你了。"
          },
          "actions": {},
          "source_branch_index": 1,
          "source_line": 14,
          "enabled": true,
          "events": [
            9,
            10,
            11,
            12
          ],
          "source": "sainasu/event/event09"
        },
        {
          "event": -1,
          "type": "MESSAGE",
          "condition": "ENDEV=9",
          "texts": {
            "NomalMsg": "希望能有精灵保佑你。"
          },
          "actions": {},
          "source_branch_index": 2,
          "source_line": 27,
          "enabled": true,
          "events": [
            9,
            10,
            11,
            12
          ],
          "source": "sainasu/event/event09"
        }
      ]
    },
    {
      "id": "sainasu/event/event10@1300:65:65",
      "source_script": "sainasu/event/event10",
      "source_create": "gmsv/data/npc/sainasu/event/event09-12.create",
