extends "res://tests/quest_arrival_backend_test.gd"
func walk_sage(b)->void:
 check(RouteDriver.walk(b,41,Vector2i(34,27),[41]).ok,"actual reward-room steps reach sage without project movement")
func run()->void:
 var old:Callable=WorldClock.clock;WorldClock.clock=func():return WorldClock.ERA+100
 var b=fresh();adult(b);Equipment.add(b.session._profile,2603);root.add_child(b)
 var server=Server.new(b,0,"127.0.0.1");root.add_child(server);check(server.start()==OK,"arrival two-device port0 server")
 for i in range(2):
  var link=Link.new("ws://127.0.0.1:%d"%server.port);links.append(link);link.connect_now()
 check(await Wait.until(self,func():poll();return links.all(func(l):return l.online)),"two actual sockets share character backend")
 for link in links:await request(link,{"type":"ping"})
 for map_id in [41,42]:
  var before:Dictionary=b.session.snapshot()
  check((await request(links[0],{"type":"reviewed_hunt_travel","map_id":map_id,"area_id":416 if map_id==41 else 427,"template_id":72})).ok,"socket capture reaches reviewed reward component")
  for y in range(34,26,-1):check((await request(links[1],{"type":"report_position","map_id":map_id,"cell":[34,y]})).ok,"second device walks captured character toward sage")
  check(not (await request(links[1],{"type":"quest_talk","npc_id":"seimu/event/event01_2@%d:34:25"%map_id})).ok,"real sage refuses capture visitor on both maps")
  check(b.session.snapshot().original_items==before.original_items and b.session.snapshot().original_events==before.original_events,"refusal preserves all flags and original items")
 enter_route(b);start_guard(b)
 b.save_path="user://arrival-remote-missing/save.json";fight(b)
 check(not b.battle_state.get("settled",false),"real final guard failed save grants no reward arrival")
 check(not (await request(links[0],{"type":"battle_close"})).ok,"other device cannot close failed settlement")
 b.save_path="";check((await request(links[1],{"type":"battle_close"})).ok,"same frozen settlement retry commits and publishes original Warp")
 walk_sage(b)
 var before:Dictionary=b.session.snapshot()
 var r:Dictionary=await request(links[0],{"type":"quest_talk","npc_id":SAGE_ID})
 check(r.ok,"normal saved final battle opens actual reward on first device")
 r=await request(links[0],{"type":"quest_choose","token":r.get("dialogue",{}).get("token",""),"choice":"yes"})
 var token:String=str(r.get("dialogue",{}).get("token",""))
 check((await request(links[1],{"type":"reviewed_hunt_travel","map_id":41,"area_id":416,"template_id":72})).ok,"second device capture movement clears prior visit proof")
 walk_sage(b)
 check(not (await request(links[0],{"type":"quest_choose","token":token,"choice":"ok"})).ok and b.session.snapshot()==before,"stale first-device reward token cannot survive capture reentry")
 enter_route(b);start_guard(b);fight(b);check(b.handle({"type":"battle_close"}).ok,"fresh actual final win restores eligibility")
 walk_sage(b)
 r=await request(links[1],{"type":"quest_talk","npc_id":SAGE_ID})
 r=await request(links[1],{"type":"quest_choose","token":r.get("dialogue",{}).get("token",""),"choice":"yes"})
 r=await request(links[1],{"type":"quest_choose","token":r.get("dialogue",{}).get("token",""),"choice":"ok"})
 check(r.ok and not 2603 in b.session.snapshot().original_items,"normal saved final victory really delivers source light and reward")
 var save:="user://reviewed-arrival-restart.json";check(b.session.save_game(save),"earned profile saves without runtime proof")
 var restored=Backend.new();check(restored.load_profile(save),"fresh server loads same profile")
 restored.automation.position_changed(41,Vector2i(34,27))
 check(not restored.quest_arrival.has_arrival(restored,41,Vector2i(34,27)),"server restart cannot restore runtime arrival from profile")
 restored.free()
 for suffix in ["",".bak",".tmp"]:DirAccess.remove_absolute(ProjectSettings.globalize_path(save+suffix))
 for link in links:link.close()
 links=[];server.stop();server.queue_free();b.queue_free();WorldClock.clock=old
 print("REVIEWED HUNT ARRIVAL REMOTE: %d failures"%failures);quit(1 if failures else 0)
