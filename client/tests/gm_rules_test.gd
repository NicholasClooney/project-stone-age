extends SceneTree
const Game=preload("res://server/game_session.gd")
const Battle=preload("res://server/battle_session.gd")
const Growth=preload("res://server/progression.gd")
var failures:=0
func check(value:bool,note:String)->void:
	if value:print("PASS: "+note)
	else:failures+=1;push_error("FAIL: "+note)
func _initialize()->void:
	var game=Game.new()
	var pet:=Growth.species_actor("wooli",1,573)
	pet.merge({"species":"wooli","name":"乌力","sprite":100250,"level":1,"xp":0,"skill_unlocked":false})
	game._profile.pets.append(pet)
	var expected:Dictionary=pet.duplicate(true)
	for level in range(2,121):Growth.grow_pet(expected,level)
	check(game.gm_raise_level(0,120) and game.snapshot().pets[0].base_stats==expected.base_stats,"level120 pet applies originalgrowth exactlyonceperlevel")
	var at120:Dictionary=game.snapshot().pets[0].duplicate(true)
	check(game.gm_raise_level(0,120) and game.snapshot().pets[0]==at120,"repeating level120 doesnotrerollgrowth")
	check(not game.gm_raise_level(0,119),"lowering level refused")
	check(game.gm_raise_level(-1,120) and game.snapshot().player.stat_points==357,"player level120 earns normal357allocationpoints")
	check(game.gm_set_base_stat(-1,"strength",100.0) and game.snapshot().player.base_stats.strength==10000,"wholebaseunits convertto fixedpointx100")
	check(game.gm_set_base_stat(-1,"strength",2.25,true) and game.snapshot().player.base_stats.strength==10225,"fractional additivebaseunits preserved")
	var before:Dictionary=game.snapshot()
	check(not game.gm_set_base_stat(-1,"strength",INF) and not game.gm_set_base_stat(-1,"strength",NAN) and not game.gm_raise_level(-1,INF) and game.snapshot()==before,"nonfiniteinputs rejectedwithoutmutations")
	check(game.gm_grant_points(10) and game.allocate_stat("vitality") and game.snapshot().player.stat_points==366,"bonusallocationpoints survive normalspending")
	game._profile.player.hp=1
	check(game.gm_heal(-1) and game.snapshot().player.hp==game.snapshot().player.max_hp,"GM heal restores selectedactor")
	check(game.snapshot().gm_modified and game.snapshot().pets[0].gm_modified,"GM flags track profileandmodifiedactors")
	var path:="user://gm-controls-test.json"
	check(game.save_game(path),"GM profile passes savevalidation")
	var loaded=Game.new()
	check(loaded.load_game(path) and loaded.snapshot().gm_bonus_points==10 and loaded.snapshot().player.stat_points==366 and loaded.snapshot().pets[0].gm_modified,"GM changes andpoints survive reload")
	var battle=Battle.new()
	battle.start_battle(game.start_battle_config("wooli",false,2))
	before=game.snapshot()
	check(not game.gm_set_base_stat(-1,"strength",1) and not game.gm_grant_points(1) and not game.gm_heal() and not game.gm_raise_level(0,120) and game.snapshot()==before,"battlelocks every progressionmutation")
	var result:Dictionary=battle.developer_escape()
	check(result.outcome=="escaped" and result.turn_frames[0].outcome=="escape" and result.xp==0 and result.gold==0,"GM escape supplies normalescapeanimationframe withoutrewards")
	check(game.apply_battle_result(result) and game.snapshot().player.gold==before.player.gold and game.snapshot().player.xp==before.player.xp and game.snapshot().pets.size()==before.pets.size(),"escape settles authority anddoesnotgrantrewards")
	check(not game.apply_battle_result(result),"GM escape settlement cannotreplay")
	DirAccess.remove_absolute(ProjectSettings.globalize_path(path))
	DirAccess.remove_absolute(ProjectSettings.globalize_path(path+".bak"))
	print("GM RULES: %d failures" % failures)
	quit(1 if failures else 0)
