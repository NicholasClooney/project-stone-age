      "selected_branch_evidence": {
        "quiz/equiz_01": [
          {
            "index": 3,
            "source_line": 29,
            "sha256": "30601f2be78a49b6a53bb099ecd3b8dd556e9730f5f87be247427e18ffc3f995",
            "fields": {
              "EventNo": "44",
              "TYPE": "REQUEST",
              "EVENT": "LV>0",
              "RequestMsg": "\\n\\n厉害！没想到能够来到12楼呀！\\n给来到这里的你猜谜大师的\\n入门证吧！可以收下吗？",
              "ThanksMsg": "\\n\\n把这个入门证交给隔壁的伊那多\\n询问成为猜谜大师的课题吧！\\n你也以猜谜大师为目标！",
              "StopMsg": "\\n\\n\\n不想成为猜谜大师？",
              "EndStopMsg": "\\n\\n\\n那么，等你想来的时候再来吧！",
              "NoStopMsg": "\\n\\n\\n这样的话，快点把入门证交给伊那多喔！",
              "ItemFullMsg": "\\n\\n\\n道具已经满了无法收下的样子喔。",
              "GetItem": "2753"
            }
          }
        ],
        "quiz/equiz_02": [
          {
            "index": 4,
            "source_line": 38,
            "sha256": "9c62d5d849bfae170dbdc8244344b66a7eaaa3c74a9d38fc408d9199e6e9d271",
            "fields": {
              "EventNo": "44",
              "TYPE": "ACCEPT",
              "EVENT": "NOWEV=44&ITEM=2753",
              "AcceptMsg": "\\n\\n哎呀！那个是猜谜大师的入门证吧！\\n你也迈向猜谜大师之路了吗？",
              "ThanksMsg": "\\n很好，很有干劲喔！\\n那么的话我就出成为猜谜大师的课题啰\\n等到现在交给你的稀有宠物\\n等级成为LV77之后是否可以带来给我呢？\\n如果无法达成这个条件的话我就没有办法带你到成为\\n猜谜大师的认定场\\n认定场喔。那么、加油啰！",
              "PetFullMsg": "\\n\\n因为宠物太多而无法交给你喔。\\n能否把宠物的数量减少之后再来呢？",
              "GetPet": "14",
              "DelItem": "2753",
              "EndSetFlg": "44"
            }
          }
        ]
      }
    }
